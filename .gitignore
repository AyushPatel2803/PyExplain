# ---- Virtual environment (huge, machine-specific) ----
venv/
env/
.venv/

# ---- Downloaded models & caches (many GB — never commit) ----
hf_cache/
pip_cache/
tmp/
*.safetensors
*.bin
*.gguf

# ---- Training outputs / checkpoints (regenerated by training) ----
output/
checkpoints/

# ---- Generated data (rebuilt by prepare_data.py) ----
data/train.jsonl
data/val.jsonl

# ---- Logs ----
*.log

# ---- Python junk ----
__pycache__/
*.pyc
*.pyo

# ---- Editor / tooling ----
.claude/
.vscode/
.idea/
